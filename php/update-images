#!/bin/sh

set -e

php_versions="8.0 8.1 8.2 8.3 8.4 8.5"
php_latest_version="8.5"
date_postfix=`date +%Y%m%d`

if [ $# != 0 ]; then
    php_versions="$*"
fi

function xdebug_version_argument() {
    case $1 in
        *)
            echo ""
            ;;
    esac
}

function phpstan_version_argument() {
    case $1 in
        *)
            echo ""
            ;;
    esac
}

function phpcs_version_argument() {
    case $1 in
        *)
            echo ""
            ;;
    esac
}

for v in $php_versions; do
    docker build . --build-arg PHP_VERSION=$v $(xdebug_version_argument $v) $(phpstan_version_argument $v) $(phpcs_version_argument -v) --no-cache -t robtimus/php-toolset:$v
    # no need to show the xdebug version separately, that's included in php --version
    docker run --rm robtimus/php-toolset:$v sh -c "php --version && composer --version && php -r 'phpinfo();' | grep xdebug >/dev/null && phpstan --version && phpcs --version"
    echo
done
for v in $php_versions; do
    docker tag robtimus/php-toolset:$v robtimus/php-toolset:$v-$date_postfix
    docker push robtimus/php-toolset:$v-$date_postfix
    docker push robtimus/php-toolset:$v
    echo
done
docker tag robtimus/php-toolset:$php_latest_version robtimus/php-toolset && docker push robtimus/php-toolset
